NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couple_expenses
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me
LINE_GROUP_ID=replace-me
LINE_MEMBER_USER_IDS=Uxxxxxxxx,Uyyyyyyyy
LINE_PUBLIC_SIGNUP_ENABLED=false
LEDGER_TIMEZONE=Asia/Taipei
# Generate once with: openssl rand -base64 32
OUTBOX_CREDENTIAL_KEY_BASE64=replace-with-32-byte-base64-key
# Must be on storage with an independent backup/recovery lifecycle from PostgreSQL.
DELETION_JOURNAL_DIRECTORY=/absolute/path/to/deletion-journal
